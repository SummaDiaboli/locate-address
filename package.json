{
  "name": "locate-address",
  "version": "0.1.0",
  "description": "Framework-agnostic location autofill with pluggable reverse geocoding providers",
  "keywords": [
    "geolocation",
    "location",
    "autofill",
    "address",
    "reverse-geocoding",
    "typescript"
  ],
  "homepage": "https://github.com/SummaDiaboli/locate-address#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SummaDiaboli/locate-address.git"
  },
  "bugs": {
    "url": "https://github.com/SummaDiaboli/locate-address/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "import": "./dist/dom/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "demo": "vite --config examples/basic/vite.config.ts --host",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "fast-check": "^4.11.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue": "^3.5.46"
  }
}
